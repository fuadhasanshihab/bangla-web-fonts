  clip-rule: evenodd;
  fill: transparent;
  fill-rule: evenodd;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-miterlimit: 10;
  stroke-width: 1.5px;
}
.bookmark-wrapper {
  z-index: 50;
  opacity: 0;
  position: fixed;
  right: 0px;
  top: 63px;
  left: 0;
  bottom: 0;
  transform: translateY(1rem);
  -webkit-transform: translateY(1rem);
  visibility: hidden;
  width: 100%;
  height:100%;
  display: flex;               /* flex */
  justify-content: center;     /* justify-center */
  padding-left: 1.75rem;       /* px-7 → 7 * 0.25rem = 1.75rem */
  padding-right: 1.75rem;      /* same as above */
}
.bookmark-wrapper-inside {
  border: 1px dashed #dfdfdf;
  border-radius: 0.5rem;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1),
              0 8px 10px -6px rgba(0, 0, 0, 0.1);
  max-height: 400px;
  width: 100%;
  max-width: 448px;
  overflow: auto;
  transform: translateY(1rem);
  -webkit-transform: translateY(1rem);
  width: 100%;
}
.bookmark-title {
  border-bottom: 1px dashed #ededed;
  font-weight: 600;
  position: sticky;
  position: -webkit-sticky;
  top: 0;
}
.bm-title {
  line-height: 1.5em;
}
.bm-title a {
  color: inherit;
}
.bm-title a:hover {
  text-decoration: none;
}
.bm-thumb {
  flex: 0 0 85px;
  line-height: 2;
  background: red;
  font-size: 45px;
  padding: 20px;
  border-radius: 8px;
}
.bm-thumbb div {
  background: red;
  border-radius: 7px;
  padding: auto;
  object-fit: cover;
  height: auto;
  max-height: 100% !important;
  width: 100%;
  max-width: 100% !important;
}
.bm-delete {
  margin-left: auto;
  white-space: nowrap;
}
.bm-delete svg {
  height: 1.25rem;
  width: 1.25rem;
}
.bm-delete path {
  fill: none;
  stroke: var(--bm-icon-del);
}
.bm-delete:hover path {
  fill: var(--bm-icon-del);
}
.bookmark-inner ul {
  flex-direction: column;
}
.bookmark-wrapper, .bookmark-title {
  background-color: var(--bm-bg);
}
.bookmark-inner, .bookmark-title {
  padding: .75rem 1.25rem;
}
.bookmark-inner ul, .bookmark-inner li, .fontBookmarks li, .fontBookmarkPost, .fontBookmarkPost label {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  gap: 1rem;
  list-style-type: none;
  margin: 0;
  padding: 0;
}
li.bm-more {
  border-top: 1px solid #ededed;
  justify-content: center;
  padding: .75rem .75rem 0;
  margin-top: 1rem;
}
.fontBookmarks ul {
  display: grid;
  gap: 1.5rem;
  grid-template-columns: repeat(2, 1fr);
  margin: 0;
  padding: 0;
}
.fontBookmarks li {
  border: 1px solid #dfdfdf;
  border-radius: 7px;
  padding: .75rem;
}
.fontBookmarkPost {
  background-color: var(--bm-post-bg);
  border-radius: 100px;
  height: 2rem;
  width: 2rem;
  z-index: 2;
}
.fontBookmarkPost, .fontBookmarkPost label {
  align-items: center;
  justify-content: center;
}
.fontBookmarkPost svg {
  height: 1.25rem;
  width: 1.25rem;
}
.fontBookmark label, .fontBookmarkPost label, .bm-delete {
  cursor: pointer;
}
.fontBookmark i {
  position: absolute;
}
.fontBookmark path, .bookmark-wrapper {
  transition: all .2s ease;
}
.fontBookmark label:hover path, .fontBookmarkPost label:hover path {
  stroke: var(--bm-icon-active);
}
#fontBookmark:checked ~ label path, .fontBookmarkPost input:checked ~ label path {
  fill: var(--bm-icon-active);
  stroke: var(--bm-icon-active);
}
.fontBookmarkPost input:checked ~ label path:last-child {
  fill: none;
  stroke: #fff;
}
#fontBookmark:checked ~ .bookmark-wrapper {
