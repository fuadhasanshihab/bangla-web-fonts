  transform: translateY(0);
  -webkit-transform: translateY(0);
  visibility: visible;
}
.bookmark-loading {
  padding: .5rem;
  text-align: center;
}
.bookmark-loading svg {
  animation: fontSpin .75s linear infinite normal;
  -webkit-animation: fontSpin .75s linear infinite normal;
}
@media screen and (max-width: 568px) {
  .fontBookmarks ul {
    gap: 1rem;
    grid-template-columns: repeat(1, 1fr);
 }
