<div class="ns-hidden">
<label for="previewText" class="sr-only">Write font preview text</label>
<input id="previewText" type="text" placeholder="Type here to preview text" class="mt-10 w-full border border-dashed border-gray-300 dark:border-gray-800 bg-white rounded-xl px-3 py-3 focus:outline-none focus:ring-1 focus:ring-gray-400">
<div class="flex items-center justify-between mt-4">
  <div class="relative w-28 mr-4">
    <label for="fontSizeDropdown" class="sr-only">Font size dropdown</label>
    <select id="fontSizeDropdown" class="w-full border border-dashed border-gray-300 cursor-pointer rounded-xl px-3 py-1 bg-white appearance-none text-md focus:outline-none focus:ring-1 focus:ring-gray-400">
      <option value="16">16px</option>
      <option value="24">24px</option>
      <option value="32">32px</option>
      <option value="40" selected>40px</option>
      <option value="48">48px</option>
      <option value="64">64px</option>
    <option value="80">80px</option>
      <option hidden value="custom">Custom</option>
    </select>
    <span class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 pointer-events-none"><!--▼-->
<svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="-.03 9.73 19.27 12.28"><path fill="currentColor" d="m18.81 11.4-7.9 9.91c-.75.9-1.9.9-2.63 0l-7.9-9.9c-.75-.94-.38-1.66.78-1.66h16.87c1.19 0 1.53.72.78 1.66"/></svg>
    </span>
  </div>
  <label for="fontSizeSlider" class="sr-only">Font size slider</label>
  <input id="fontSizeSlider" type="range" min="8" max="80" step="1" value="40" class="w-2/3 h-1 md:h-2 bg-gray-200 dark:bg-gray-800 rounded-lg appearance-none cursor-pointer">
  <button id="italicToggle" class="border border-dashed border-gray-300 dark:border-gray-800 rounded-xl px-3 py-1 bg-white text-black dark:text-white text-md ml-4 transition">Italic</button>
</div>
</div>
